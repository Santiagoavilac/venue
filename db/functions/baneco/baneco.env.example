# Valores reales sólo en los secretos de Supabase, nunca en Git ni frontend.
BANECO_AMBIENTE=certificacion
BANECO_BASE_URL=https://apimktdesa.baneco.com.bo/ApiGateway/
BANECO_USER=
BANECO_PASSWORD=
BANECO_AES_KEY=
BANECO_ACCOUNT=
# Producción: obligatoria, ISO 8601 con zona y vencimiento confirmado.
# Certificación: opcional si el banco no comunicó un vencimiento.
BANECO_CREDENTIALS_EXPIRES_AT=
BANECO_CRON_TOKEN=
# Opcional. El receptor queda deshabilitado mientras no se configure.
BANECO_WEBHOOK_TOKEN=
# Sólo después de recibir confirmación del banco y autorización del responsable.
BANECO_PRODUCTION_APPROVED=false
BANECO_PRODUCTION_HOST=
